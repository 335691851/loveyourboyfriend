{
  "name": "loveyourboyfriend",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter web dev",
    "test": "pnpm test:web",
    "test:web": "pnpm --filter web test",
    "lint": "pnpm lint:web",
    "lint:web": "pnpm --filter web lint && pnpm --filter web typecheck",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter web build",
    "format": "prettier --write \"apps/web/**/*.{js,mjs,ts,tsx,css,json}\" \"docs/**/*.md\" \"*.{json,yaml,yml,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{js,mjs,ts,tsx,css,json}\" \"docs/**/*.md\" \"*.{json,yaml,yml,md}\""
  },
  "devDependencies": { "prettier": "3.9.5" }
}
